#!/sbin/openrc-run
name="ServiceReady"
description="Integrated Services Portal"
supervisor="supervise-daemon"
command="/opt/serviceready/venv/bin/python"
command_args="-m voiceservices.server --config /etc/serviceready/config.json"
command_user="serviceready:serviceready"
directory="/var/lib/serviceready"
pidfile="/run/serviceready/supervisor.pid"
output_log="/var/log/serviceready/service.log"
error_log="/var/log/serviceready/error.log"
respawn_delay=3
respawn_max=5
respawn_period=60

depend() {
    need net
    after firewall
}
start_pre() {
    checkpath --directory --owner serviceready:serviceready --mode 0750 /run/serviceready /var/log/serviceready
}
