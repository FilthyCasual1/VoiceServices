#!/bin/sh /etc/rc.common
START=94
STOP=11
USE_PROCD=1
start_service() {
    mkdir -p /run/serviceready-accounts /tmp/serviceready
    chown root:serviceready /run/serviceready-accounts
    chmod 0750 /run/serviceready-accounts
    chown serviceready:serviceready /tmp/serviceready
    chmod 0700 /tmp/serviceready
    if [ -f /etc/serviceready/setup-token ]; then
        printf '\nINSAP first-boot setup code: ' > /dev/console
        cat /etc/serviceready/setup-token > /dev/console
    fi
    procd_open_instance
    procd_set_param command /usr/bin/python3 /opt/serviceready/account-broker.py
    procd_set_param env PYTHONPATH=/opt/serviceready/app PYTHONDONTWRITEBYTECODE=1
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
