#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    [ -f /etc/serviceready/config.json ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 -m voiceservices.server --config /etc/serviceready/config.json
    procd_set_param env PYTHONPATH=/opt/serviceready/app PYTHONDONTWRITEBYTECODE=1 TMPDIR=/tmp/serviceready
    procd_set_param user serviceready
    procd_set_param group serviceready
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/serviceready/config.json
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
