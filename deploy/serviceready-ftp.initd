#!/sbin/openrc-run
name="ServiceReady Update Addon Worker"
supervisor="supervise-daemon"
command="/opt/serviceready/venv/bin/python"
command_args="-m voiceservices.ftp_service --config /etc/serviceready/config.json"
command_user="root:root"
# Worker binds port 21, then permanently drops to serviceready before serving.
pidfile="/run/serviceready-ftp/supervisor.pid"
error_log="/var/log/serviceready/ftp-error.log"
respawn_delay=3
depend() { need net; }
start_pre() { checkpath --directory --owner serviceready:serviceready --mode 0750 /run/serviceready-ftp; }
