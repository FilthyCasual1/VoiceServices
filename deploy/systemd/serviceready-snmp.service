[Unit]
Description=ServiceReady snmp
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/serviceready/config.json

[Service]
Type=simple
User=serviceready
Group=serviceready
WorkingDirectory=/var/lib/serviceready
Environment=TMPDIR=/var/lib/serviceready/tmp
ExecStart=/opt/serviceready/venv/bin/python -m voiceservices.snmp_service --config /etc/serviceready/config.json
RuntimeDirectory=serviceready-snmp
RuntimeDirectoryMode=0750
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0027

[Install]
WantedBy=multi-user.target
