[Unit]
Description=ServiceReady accounts
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/serviceready/config.json

[Service]
Type=simple
User=root
Group=serviceready
WorkingDirectory=/var/lib/serviceready
Environment=TMPDIR=/var/lib/serviceready/tmp
ExecStart=/opt/serviceready/venv/bin/python /opt/serviceready/account-broker.py
RuntimeDirectory=serviceready-accounts
RuntimeDirectoryMode=0750
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0027

[Install]
WantedBy=multi-user.target
