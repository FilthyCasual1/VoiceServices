#!/sbin/openrc-run
name="ServiceReady Accounts"
supervisor="supervise-daemon"
command="/usr/bin/python3"
command_args="/opt/serviceready/account-broker.py"
command_user="root:root"
pidfile="/run/serviceready-accounts/supervisor.pid"
respawn_delay=3
start_pre() {
    checkpath --directory --owner root:serviceready --mode 0750 /run/serviceready-accounts
}
